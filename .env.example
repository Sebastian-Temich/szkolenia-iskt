# szkolenia.iskt.pl — szablon zmiennych środowiskowych
#
# Skopiuj do `.env.local` i wypełnij wartościami LOKALNEGO stacku Supabase.
# `.env.local` jest w .gitignore i nigdy nie trafia do repozytorium.
#
# ZASADY (ADR-0002):
#   1. Ten plik nie zawiera żadnych wartości — tylko nazwy i opisy.
#   2. Zmienne z prefiksem NEXT_PUBLIC_ są widoczne w przeglądarce.
#      Nigdy nie umieszczaj tam sekretu.
#   3. Repozytorium jest PUBLICZNE (decyzja ISKT z 2026-10-09). Nie wpisuj tu
#      ani nigdzie w repozytorium identyfikatorów środowisk: referencji projektu
#      Supabase, adresów hostingu, identyfikatorów kont. Identyfikator produkcyjnego
#      projektu Supabase zostaje WYŁĄCZNIE w Project Access Card w Obsidianie.
#   4. Wartości dla developmentu bierzesz z wyjścia `supabase start` / `supabase status`.
#      CLI wypisuje DWA zestawy kluczy: ANON_KEY / SERVICE_ROLE_KEY (tokeny JWT, "eyJ...")
#      oraz PUBLISHABLE_KEY / SECRET_KEY ("sb_publishable_..." / "sb_secret_...").
#      Ta aplikacja używa zestawu JWT.
#
# LEGENDA:
#   [publiczna]    trafia do przeglądarki — nigdy nie wpisuj tu sekretu
#   [SEKRET]       wyłącznie warstwa serwerowa; nigdy z prefiksem NEXT_PUBLIC_
#   [BRAMKA ISKT]  wartość dostarcza ISKT; agent jej nie generuje i nie pozyskuje
#   [lokalna]      generujesz sam albo bierzesz z lokalnego stacku
#   [ZAREZERWOWANA] nazwa istnieje w schemacie środowiska, ale ŻADNA logika jej dziś
#                   nie odczytuje — ustawienie jej nie włącza żadnej funkcji
#
# Runbook: docs/runbook/lokalne-uruchomienie.md
# Walidacja: lib/env.ts (osobne schematy Zod dla warstwy publicznej i serwerowej)

# ─────────────────────────────────────────────────────────────────────────────
# Aplikacja
# ─────────────────────────────────────────────────────────────────────────────

# [publiczna] [lokalna] WYMAGANA
# Publiczny adres bazowy aplikacji; podstawa adresów kanonicznych, robots.txt
# i mapy witryny (lib/seo.ts). Lokalnie: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Supabase — klient publiczny (przeglądarka i renderowanie serwerowe)
# ─────────────────────────────────────────────────────────────────────────────

# [publiczna] [lokalna] WYMAGANA
# API_URL z `supabase status`, np. http://127.0.0.1:54321
# Wartość produkcyjna to identyfikator środowiska — NIE wpisuj jej w repozytorium.
NEXT_PUBLIC_SUPABASE_URL=

# [publiczna] [lokalna] WYMAGANA
# ANON_KEY z `supabase status` (token JWT, nie PUBLISHABLE_KEY).
# Ograniczony politykami RLS. Nie jest sekretem, ale go nie commitujemy.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Supabase — klucz serwerowy
# ─────────────────────────────────────────────────────────────────────────────

# [SEKRET] [lokalna w developmencie / BRAMKA ISKT na produkcji]
# Klucz service_role. OMIJA RLS. Używany w dokładnie jednym miejscu w kodzie:
# app/api/inquiries/route.ts (zapis zgłoszeń), oraz przez zadania utrzymaniowe.
# Wymagany, żeby formularz zgłoszeniowy zapisywał cokolwiek.
# NIGDY nie dodawaj prefiksu NEXT_PUBLIC_ i nie importuj w komponencie klienckim
# (lib/supabase/admin.ts ma `import "server-only"`, więc taki import jest błędem builda).
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Powiadomienia e-mail (ADR-0004)
# ─────────────────────────────────────────────────────────────────────────────

# [lokalna] WYMAGANA
# log    — treść maila trafia do logu serwera, bez wysyłki (domyślne lokalnie i w CI)
# resend — realna wysyłka; schemat środowiska WYMAGA wtedy RESEND_API_KEY i RESEND_FROM
MAIL_TRANSPORT=

# [SEKRET] [BRAMKA ISKT]
# Przekazanie klucza to bramka ISKT — nie generuj i nie pozyskuj go samodzielnie.
# Wymagany tylko przy MAIL_TRANSPORT=resend.
RESEND_API_KEY=

# [BRAMKA ISKT]
# Adres nadawcy w domenie zweryfikowanej w Resend (SPF/DKIM — weryfikacja po stronie ISKT),
# np. "ISKT Szkolenia <no-reply@iskt.pl>". Wymagany tylko przy MAIL_TRANSPORT=resend.
RESEND_FROM=

# [BRAMKA ISKT na produkcji / lokalna w developmencie] WYMAGANA
# Odbiorca powiadomień o nowych zgłoszeniach. Docelowy adres biura potwierdza ISKT.
# Lokalnie i w CI użyj adresu w domenie example.invalid.
# UWAGA RODO: powiadomienie zawiera pełne dane zgłaszającego, a skrzynka odbiorcy
# jest POZA zasięgiem purge_expired_inquiries() — retencja tej kopii to decyzja ISKT.
INQUIRY_NOTIFICATION_TO=

# ─────────────────────────────────────────────────────────────────────────────
# Ochrona antyspamowa (ADR-0004)
# ─────────────────────────────────────────────────────────────────────────────

# [SEKRET] [lokalna] WYMAGANA (min. 32 znaki)
# Sól do haszowania identyfikatora klienta w licznikach częstości (HMAC-SHA256).
# NIE jest danymi ISKT — generujesz sam: openssl rand -hex 32
# UWAGA RODO: client_hash to pseudonimizacja, nie anonimizacja; przy stałej soli
# hasze są trwale powiązywalne. Rekomendacja bramki E8: rotacja dobowa.
FORM_THROTTLE_SALT=

# [SEKRET] [lokalna] WYMAGANA (min. 32 znaki)
# Sekret podpisujący token czasowy formularza. Generujesz sam: openssl rand -hex 32
# Brak tej zmiennej powoduje, że POST /api/inquiries zwraca 500 server_misconfigured.
FORM_TOKEN_SECRET=

# [ZAREZERWOWANA] — Cloudflare Turnstile
# Trzy zmienne poniżej istnieją w schemacie środowiska (lib/env.ts), ale ŻADNA LOGIKA
# ICH NIE ODCZYTUJE. Weryfikacja Turnstile nie jest zaimplementowana — ustawienie
# TURNSTILE_ENABLED=true NIE włącza CAPTCHA i nie zmienia niczego w zachowaniu aplikacji.
# Ustalenie bramki zgodności RODO (E8 §4b, poprawka T5). Rekomendacja: nie włączać w MVP —
# Turnstile dodaje Cloudflare jako procesora danych, co wymaga DPA i aktualizacji klauzuli.
TURNSTILE_ENABLED=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Zgodność prawna
# ─────────────────────────────────────────────────────────────────────────────

# [BRAMKA ISKT]
# Numer wersji zatwierdzonej klauzuli informacyjnej RODO. Zapisywany przy KAŻDYM
# zgłoszeniu w inquiries.rodo_clause_version — to podstawa rozliczalności z art. 5 ust. 2.
# Pozostaw puste, dopóki klauzula jest szkicem: kod użyje wtedy wartości
# "DRAFT-0-niezatwierdzona" z lib/rodo/clause.ts, a strona /kontakt wyświetli
# ostrzeżenie, że treść nie jest zatwierdzona.
# ISKT dostarcza: treść klauzuli (pozycje K1–K10 raportu E8) oraz ten numer wersji.
RODO_CLAUSE_VERSION=

# ─────────────────────────────────────────────────────────────────────────────
# Czego tu NIE MA i nie będzie
# ─────────────────────────────────────────────────────────────────────────────
#
#   * żadnych wartości — ten plik jest wersjonowany;
#   * żadnych identyfikatorów środowisk (referencja projektu Supabase, adres hostingu);
#   * zmiennych CI — zadania w .github/workflows/ci.yml ustawiają je same, a klucze
#     Supabase pobierają z uruchomionego przez siebie lokalnego stacku
#     (scripts/ci-export-supabase-env.sh). ŻADEN SEKRET ISKT NIE JEST POTRZEBNY,
#     żeby CI przeszło, i żaden nie został dodany do sekretów GitHub Actions.
