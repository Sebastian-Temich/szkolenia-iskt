# szkolenia.iskt.pl — szablon zmiennych środowiskowych
#
# Skopiuj do `.env.local` i wypełnij wartościami LOKALNEGO stacku Supabase.
# `.env.local` jest w .gitignore i nigdy nie trafia do repozytorium.
#
# ZASADY (ADR-0002):
#   1. Ten plik nie zawiera żadnych wartości — tylko nazwy i opisy.
#   2. Zmienne z prefiksem NEXT_PUBLIC_ są widoczne w przeglądarce.
#      Nigdy nie umieszczaj tam sekretu.
#   3. Do czasu odrębnej decyzji ISKT NIE wpisuj tutaj danych produkcyjnego
#      projektu Supabase (identyfikator w Project Access Card) ani klucza Resend.
#   4. Wartości dla developmentu bierzesz z wyjścia `supabase start`.

# ─────────────────────────────────────────────────────────────────────────────
# Aplikacja
# ─────────────────────────────────────────────────────────────────────────────

# Publiczny adres bazowy aplikacji. Lokalnie: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Supabase — klient publiczny (przeglądarka i renderowanie serwerowe)
# ─────────────────────────────────────────────────────────────────────────────

# URL lokalnego stacku z `supabase start`, np. http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Klucz publiczny (anon / publishable) lokalnego stacku.
# Jest ograniczony politykami RLS. Nie jest sekretem, ale go nie commitujemy.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Supabase — klucz serwerowy (SEKRET, tylko warstwa serwerowa)
# ─────────────────────────────────────────────────────────────────────────────

# Klucz service_role. Omija RLS. Używany wyłącznie przez Route Handler
# zapisujący zgłoszenia i przez zadania utrzymaniowe.
# NIGDY nie dodawaj do niego prefiksu NEXT_PUBLIC_ i nie importuj w komponencie klienckim.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Powiadomienia e-mail (ADR-0004)
# ─────────────────────────────────────────────────────────────────────────────

# log    — treść maila trafia do logu serwera, bez wysyłki (domyślne lokalnie i w CI)
# resend — realna wysyłka; wymaga RESEND_API_KEY i RESEND_FROM
MAIL_TRANSPORT=

# SEKRET. Przekazanie klucza to bramka ISKT — nie generuj i nie pozyskuj go samodzielnie.
RESEND_API_KEY=

# Adres nadawcy w zweryfikowanej domenie Resend, np. "ISKT Szkolenia <no-reply@iskt.pl>"
RESEND_FROM=

# Odbiorca powiadomień o nowych zgłoszeniach. Docelowo biuro@iskt.pl.
# Lokalnie użyj adresu w domenie example.invalid.
INQUIRY_NOTIFICATION_TO=

# ─────────────────────────────────────────────────────────────────────────────
# Ochrona antyspamowa (ADR-0004)
# ─────────────────────────────────────────────────────────────────────────────

# Sól do haszowania identyfikatora klienta w licznikach częstości (HMAC-SHA256).
# Generujesz lokalnie: openssl rand -hex 32
FORM_THROTTLE_SALT=

# Sekret podpisujący token czasowy formularza. Generujesz lokalnie: openssl rand -hex 32
FORM_TOKEN_SECRET=

# Cloudflare Turnstile — przygotowany, domyślnie WYŁĄCZONY.
# Włączenie wymaga sekretów i decyzji ISKT (nowy procesor danych).
TURNSTILE_ENABLED=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Zgodność prawna
# ─────────────────────────────────────────────────────────────────────────────

# Wersja klauzuli informacyjnej RODO prezentowanej przy formularzu.
# Zapisywana przy każdym zgłoszeniu. Dopóki klauzula jest szkicem: "draft-2026-10".
RODO_CLAUSE_VERSION=
